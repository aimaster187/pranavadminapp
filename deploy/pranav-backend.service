[Unit]
Description=PRANAV Backend API & RANGIN Multi-Bot Engine
Documentation=https://github.com/pranav-ecosystem/pranav
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pranav
Group=pranav
WorkingDirectory=/opt/pranav/backend
EnvironmentFile=/etc/pranav/backend.env
ExecStart=/usr/bin/node /opt/pranav/backend/dist/server.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/pranav/backend.log
StandardError=append:/var/log/pranav/backend-error.log

# Sandboxing & hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pranav /var/backups/pranav /var/log/pranav
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
