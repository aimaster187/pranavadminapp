{
  "name": "pranav-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PRANAV Backend API, SQLite WAL Persistence Engine, and RANGIN Multi-Bot Telegram Service",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "backup": "tsx src/db/backup-cli.ts",
    "restore": "tsx src/db/restore-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
