# PRANAV Backend Production Environment Variables (Template Only - Never Commit Real Secrets)
NODE_ENV=production
PORT=8443
HOST=127.0.0.1
PRANAV_DB_PATH=./data/pranav.db
PRANAV_BACKUP_DIR=./backups
PRANAV_LOG_DIR=./logs

# 32-byte hex (64 hex chars) master key used to encrypt BotFather tokens via AES-256-GCM.
# Generate with: openssl rand -hex 32
PRANAV_MASTER_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Optional initial bootstrap owner Telegram numeric ID (can also be configured in Admin App)
OWNER_TELEGRAM_ID=

# Optional initial RANGIN bot token (can also be added & encrypted via Android Admin App)
RANGIN_BOT_TOKEN=

# Public HTTPS base URL of the VPS for automatic Telegram webhook registration
PUBLIC_BASE_URL=https://pranav.example.com

# Challenge & Session policy defaults (seconds)
CHALLENGE_TTL_SECONDS=45
ADMIN_SESSION_TTL_SECONDS=86400
SDK_SESSION_TTL_SECONDS=43200
